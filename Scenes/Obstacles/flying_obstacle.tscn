[sub_resource type="GDScript" id="GDScript_4eb7l"]
script/source = "# Inherits the ground obstacle's script
extends Obstacle

func _physics_process(_delta: float) -> void:
	$Sprite2D.play(\"enemy_fly\")
	# Flying obstacles move faster so not overlap with ground obstacles
	position.x -= speed / 2
"

